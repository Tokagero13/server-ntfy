\u2014 `find_pending(code)`, `mark_completed(id, chat_id, username, first_name, last_name)`, `create(code, expires_at, created_at)`.\n\n## Conventions\n- All functions accept required IDs as arguments and use `app.db.get_db_connection()` internally.\n- All read functions return `list[dict]` or `dict | None`; boolean 0/1 columns are cast to Python bool.\n- All write functions return the affected id (or None) and call `conn.commit()` inside their own `with` block.\n- Use type hints everywhere.\n- Do NOT add any tests here \u2014 Task 1 owns the test tree.\n\n## Acceptance\nAll six repository files exist. `python -c \"from app.repositories import endpoints, subscriptions, notification_logs, settings, discovery\"` exits 0.", "role": "architect", "priority": 0, "scope": "large", "complexity": "medium", "estimated_minutes": 240, "status": "open", "task_type": "standard", "upgrade_details": null, "depends_on": [], "parent_task_id": null, "depends_on_repo": null, "owned_files": ["app/repositories/__init__.py", "app/repositories/endpoints.py", "app/repositories/subscriptions.py", "app/repositories/notification_logs.py", "app/repositories/settings.py", "app/repositories/discovery.py"], "assigned_agent": null, "result_summary": null, "tenant_id": "default", "cell_id": null, "repo": null, "batch_eligible": false, "eu_ai_act_risk": "limited", "approval_required": false, "risk_level": "medium", "slack_context": null, "version": 4, "claimed_at": null, "completed_at": null, "closed_at": null, "claimed_by_session": null, "parent_session_id": null, "subtask_wait_started_at": null, "parent_context": null, "retry_count": 1, "max_retries": 3, "retry_delay_s": 0.0, "terminal_reason": null, "max_output_tokens": null, "meta_messages": ["Retry 1: Previous attempt failed with reason: Agent architect-7a4f1e2f died; janitor failed: ['path_exists: app/repositories/__init__.py (not found)', 'path_exists: app/repositories/endpoints.py (not found)', 'path_exists: app/repositories/subscriptions.py 